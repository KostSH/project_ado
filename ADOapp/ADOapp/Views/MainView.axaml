<UserControl
    x:Class="ADOapp.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ADOapp.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">
    <TabControl Margin="10">
        <TabItem Header="Клиенты">
            <ScrollViewer>
                <StackPanel Margin="10" Spacing="10">
                    <TextBlock Text="Клиенты" FontSize="20" FontWeight="Bold" />
                    <TextBlock
                        Text="На этой вкладке - все клиенты проката."
                        MaxWidth="300"
                        TextWrapping="Wrap" />
                    <ListBox x:Name="ClientsListBox" MaxWidth="300" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Игры">
            <ScrollViewer>
                <StackPanel Margin="10" Spacing="10">
                    <TextBlock Text="Игры" FontSize="20" FontWeight="Bold" />
                    <TextBlock
                        Text="На этой вкладке - все настольные игры."
                        MaxWidth="300"
                        TextWrapping="Wrap" />
                    <ListBox x:Name="GamesListBox" MaxWidth="300" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Аренды">
            <ScrollViewer>
                <StackPanel Margin="10" Spacing="10">
                    <TextBlock Text="Аренды" FontSize="20" FontWeight="Bold" />
                    <TextBlock
                        Text="На этой вкладке - кто какую игру брал."
                        MaxWidth="300"
                        TextWrapping="Wrap" />
                    <ListBox x:Name="RentalsListBox" MaxWidth="300" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>