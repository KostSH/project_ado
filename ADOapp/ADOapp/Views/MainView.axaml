<UserControl
    x:Class="ADOapp.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ADOapp.ViewModels"
    xmlns:data="using:ADOapp.Data"
    d:DesignHeight="760"
    d:DesignWidth="980"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">

    <TabControl Margin="16">
        <TabItem Header="Клиенты">
            <ScrollViewer>
                <StackPanel Margin="0,8,0,8" Spacing="18">
                    <TextBlock
                        Text="Управление клиентами"
                        FontSize="26"
                        FontWeight="Bold"
                        HorizontalAlignment="Center" />

                    <TextBlock
                        Text="Здесь можно добавить нового клиента, изменить данные выбранного клиента или удалить запись."
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Grid
                        ColumnDefinitions="300,24,300"
                        HorizontalAlignment="Center">

                        <Border
                            Grid.Column="0"
                            Padding="18"
                            CornerRadius="12"
                            BorderBrush="#444444"
                            BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Форма клиента"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center" />

                                <TextBlock Text="Имя и фамилия" />
                                <TextBox
                                    x:Name="ClientFullNameTextBox"
                                    MaxWidth="300"
                                    Watermark="Например: Иван Петров"
                                    KeyDown="ClientFullNameTextBox_KeyDown" />

                                <TextBlock Text="Телефон" />
                                <TextBox
                                    x:Name="ClientPhoneTextBox"
                                    MaxWidth="300"
                                    Watermark="Например: 89112223344"
                                    KeyDown="ClientPhoneTextBox_KeyDown" />

                                <TextBlock Text="Любимый жанр" />
                                <TextBox
                                    x:Name="ClientFavoriteGenreTextBox"
                                    MaxWidth="300"
                                    Watermark="Например: Стратегия"
                                    KeyDown="ClientFavoriteGenreTextBox_KeyDown" />

                                <CheckBox
                                    x:Name="ClientIsStudentCheckBox"
                                    Content="Студент"
                                    MaxWidth="300" />

                                <StackPanel Spacing="8">
                                    <Button
                                        Content="Добавить"
                                        MaxWidth="300"
                                        HorizontalAlignment="Stretch"
                                        Click="AddClientButton_Click" />
                                    <Button
                                        Content="Сохранить"
                                        MaxWidth="300"
                                        HorizontalAlignment="Stretch"
                                        Click="SaveClientButton_Click" />
                                    <Button
                                        Content="Удалить"
                                        MaxWidth="300"
                                        HorizontalAlignment="Stretch"
                                        Click="DeleteClientButton_Click" />
                                </StackPanel>

                                <Border
                                    Padding="10"
                                    CornerRadius="8"
                                    Background="#1D1D1D"
                                    BorderBrush="#333333"
                                    BorderThickness="1">
                                    <TextBlock
                                        x:Name="ClientMessageTextBlock"
                                        MinHeight="24"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Padding="18"
                            CornerRadius="12"
                            BorderBrush="#444444"
                            BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Список клиентов"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center" />

                                <ListBox
                                    x:Name="ClientsListBox"
                                    Width="300"
                                    Height="460"
                                    SelectionChanged="ClientsListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="data:Clients">
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="10"
                                                CornerRadius="8"
                                                Background="#1E1E1E"
                                                BorderBrush="#3A3A3A"
                                                BorderThickness="1">
                                                <TextBlock
                                                    Text="{Binding}"
                                                    TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Игры">
            <ScrollViewer>
                <StackPanel Margin="0,8,0,8" Spacing="18">
                    <TextBlock
                        Text="Управление играми"
                        FontSize="26"
                        FontWeight="Bold"
                        HorizontalAlignment="Center" />

                    <TextBlock
                        Text="Здесь можно добавить новую игру или удалить выбранную запись."
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Grid
                        ColumnDefinitions="300,24,300"
                        HorizontalAlignment="Center">

                        <Border
                            Grid.Column="0"
                            Padding="18"
                            CornerRadius="12"
                            BorderBrush="#444444"
                            BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Форма игры"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center" />

                                <TextBlock Text="Название игры" />
                                <TextBox
                                    x:Name="GameTitleTextBox"
                                    MaxWidth="300"
                                    Watermark="Например: Alias"
                                    KeyDown="GameTitleTextBox_KeyDown" />

                                <TextBlock Text="Жанр" />
                                <TextBox
                                    x:Name="GameGenreTextBox"
                                    MaxWidth="300"
                                    Watermark="Например: Слова"
                                    KeyDown="GameGenreTextBox_KeyDown" />

                                <TextBlock Text="Количество игроков" />
                                <TextBox
                                    x:Name="GamePlayerCountTextBox"
                                    MaxWidth="300"
                                    Watermark="Например: 6"
                                    KeyDown="GamePlayerCountTextBox_KeyDown" />

                                <CheckBox
                                    x:Name="GameIsPartyGameCheckBox"
                                    Content="Пати-игра"
                                    MaxWidth="300" />

                                <StackPanel Spacing="8">
                                    <Button
                                        Content="Добавить"
                                        MaxWidth="300"
                                        HorizontalAlignment="Stretch"
                                        Click="AddGameButton_Click" />
                                    <Button
                                        Content="Удалить"
                                        MaxWidth="300"
                                        HorizontalAlignment="Stretch"
                                        Click="DeleteGameButton_Click" />
                                </StackPanel>

                                <Border
                                    Padding="10"
                                    CornerRadius="8"
                                    Background="#1D1D1D"
                                    BorderBrush="#333333"
                                    BorderThickness="1">
                                    <TextBlock
                                        x:Name="GameMessageTextBlock"
                                        MinHeight="24"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Padding="18"
                            CornerRadius="12"
                            BorderBrush="#444444"
                            BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Список игр"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center" />

                                <ListBox
                                    x:Name="GamesListBox"
                                    Width="300"
                                    Height="460">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="data:Games">
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="10"
                                                CornerRadius="8"
                                                Background="#1E1E1E"
                                                BorderBrush="#3A3A3A"
                                                BorderThickness="1">
                                                <TextBlock
                                                    Text="{Binding}"
                                                    TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Аренды">
            <ScrollViewer>
                <StackPanel Margin="0,8,0,8" Spacing="18">
                    <TextBlock
                        Text="Управление арендами"
                        FontSize="26"
                        FontWeight="Bold"
                        HorizontalAlignment="Center" />

                    <TextBlock
                        Text="На этой вкладке можно создать новую аренду или удалить выбранную запись."
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Grid
                        ColumnDefinitions="300,24,300"
                        HorizontalAlignment="Center">

                        <Border
                            Grid.Column="0"
                            Padding="18"
                            CornerRadius="12"
                            BorderBrush="#444444"
                            BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Форма аренды"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center" />

                                <TextBlock Text="Клиент" />
                                <ComboBox
                                    x:Name="RentalClientComboBox"
                                    MaxWidth="300" />

                                <TextBlock Text="Игра" />
                                <ComboBox
                                    x:Name="RentalGameComboBox"
                                    MaxWidth="300" />

                                <TextBlock Text="Дата начала" />
                                <CalendarDatePicker
                                    x:Name="RentalStartDatePicker"
                                    MaxWidth="300" />

                                <TextBlock
                                    Text="Дата окончания (можно оставить пустой)"
                                    TextWrapping="Wrap" />
                                <CalendarDatePicker
                                    x:Name="RentalEndDatePicker"
                                    MaxWidth="300" />

                                <TextBlock Text="Цена в рублях" />
                                <TextBox
                                    x:Name="RentalPriceRubTextBox"
                                    MaxWidth="300"
                                    Watermark="Например: 500"
                                    KeyDown="RentalPriceRubTextBox_KeyDown" />

                                <CheckBox
                                    x:Name="RentalIsReturnedCheckBox"
                                    Content="Возвращена"
                                    MaxWidth="300" />

                                <StackPanel Spacing="8">
                                    <Button
                                        Content="Добавить"
                                        MaxWidth="300"
                                        HorizontalAlignment="Stretch"
                                        Click="AddRentalButton_Click" />
                                    <Button
                                        Content="Удалить"
                                        MaxWidth="300"
                                        HorizontalAlignment="Stretch"
                                        Click="DeleteRentalButton_Click" />
                                </StackPanel>

                                <Border
                                    Padding="10"
                                    CornerRadius="8"
                                    Background="#1D1D1D"
                                    BorderBrush="#333333"
                                    BorderThickness="1">
                                    <TextBlock
                                        x:Name="RentalMessageTextBlock"
                                        MinHeight="24"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Padding="18"
                            CornerRadius="12"
                            BorderBrush="#444444"
                            BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Список аренд"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center" />

                                <ListBox
                                    x:Name="RentalsListBox"
                                    Width="300"
                                    Height="460">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="data:Rentals">
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="10"
                                                CornerRadius="8"
                                                Background="#1E1E1E"
                                                BorderBrush="#3A3A3A"
                                                BorderThickness="1">
                                                <TextBlock
                                                    Text="{Binding}"
                                                    TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>